# Copy to .env and edit as needed. Every value below is optional — the defaults
# in research_rag/config.py are what the project uses when .env is absent.

# ── Weaviate ───────────────────────────────────────────────────────────────
# Ports default to 8081/50052 rather than Weaviate's usual 8080/50051 so this
# project can run alongside another Weaviate instance on the same machine.
# Change these and docker compose picks them up too.
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8081
WEAVIATE_GRPC_PORT=50052
WEAVIATE_COLLECTION=ResearchChunk

# ── Ollama ─────────────────────────────────────────────────────────────────
# qwen3:4b-instruct scored highest on scripts/eval_models.py (98%) and is also
# the fastest tested. Any instruct model works; run the benchmark to compare.
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://localhost:11434
# Let hybrid models (qwen3:8b, qwen3:14b) reason before answering. Off by default:
# 15x slower on the routing tasks and slightly less accurate.
OLLAMA_THINK=false

# ── Models ─────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Search the section summaries as a second retrieval channel alongside chunks.
USE_SECTION_CHANNEL=true

# ── Retrieval ──────────────────────────────────────────────────────────────
TOP_K=5
RERANK_FETCH_MULTIPLIER=4

# ── App ────────────────────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=7860
PAPERS_DIR=./papers
