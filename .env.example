# Copy to .env and edit as needed. Every value below is optional; the defaults
# in research_rag/config.py are what the project uses when .env is absent.

# ── Weaviate ───────────────────────────────────────────────────────────────
# Ports default to 8081/50052 rather than Weaviate's usual 8080/50051 so this
# project can run alongside another Weaviate instance on the same machine.
# Change these and docker compose picks them up too.
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8081
WEAVIATE_GRPC_PORT=50052
WEAVIATE_COLLECTION=ResearchChunk

# ── Ollama ─────────────────────────────────────────────────────────────────
# qwen3:4b-instruct scored highest on scripts/eval_models.py (98%) and is also
# the fastest tested. Any instruct model works; run the benchmark to compare.
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://localhost:11434
# Let hybrid models (qwen3:8b, qwen3:14b) reason before answering. Off by default:
# 15x slower on the routing tasks and slightly less accurate.
OLLAMA_THINK=false

# Per-step model overrides. Unset means "use OLLAMA_MODEL everywhere", which is
# what measured best. Provided because the steps do want different things, not
# because a bigger model helps: routing is a short classification where
# qwen3:4b-instruct beat qwen3:14b (98% vs 96%), and pointing the answer step at
# the 14B measured 87% against the 4B's 89% while tripling latency.
# OLLAMA_MODEL_ROUTING=
# OLLAMA_MODEL_EXTRACT=
# OLLAMA_MODEL_ANSWER=

# ── Models ─────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Search the section summaries as a second retrieval channel alongside chunks.
USE_SECTION_CHANNEL=true

# ── Retrieval ──────────────────────────────────────────────────────────────
TOP_K=5
RERANK_FETCH_MULTIPLIER=4

# Two-stage retrieval: rank whole papers first, then search chunks only inside
# the best N. 0 searches every chunk flat.
#
# Off by default because it was measured and it loses on a small library. At 54
# papers, shortlisting to 20 took the right paper from 95% to 90% and saved no
# time, because searching 3,900 chunks flat is already milliseconds. It becomes
# the right trade when the corpus is large enough that a flat scan costs real
# time - hundreds of papers - and the recall curve below is the price:
#   top 5 -> 69%   top 10 -> 79%   top 20 -> 90%   top 30 -> 94%   off -> 95%
PAPER_PREFILTER_N=0
PAPER_PREFILTER_MIN_CORPUS=40

# ── App ────────────────────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=7860
PAPERS_DIR=./papers
