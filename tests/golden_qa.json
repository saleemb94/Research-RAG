{
 "_about": {
  "purpose": "Golden question/answer set for measuring retrieval and generation quality.",
  "provenance": "Every fact was read from the source PDF with PyMuPDF, not from the search index, so the set also detects content lost during ingestion.",
  "fields": {
   "paper": "Filename the answer lives in.",
   "question": "Asked verbatim through /api/chat.",
   "section_type": "Section the router should target. null means no single section owns the answer.",
   "expected_sections": "Stored section_name values that should supply the chunks. Advisory, not scored strictly.",
   "key_facts": "List of fact groups. A group is a list of acceptable surface forms (OR). A summary scores a point per group it contains. Digits are compared with commas stripped, so '1,054' matches '1054'.",
   "mode": "'single' (or absent) = a fact inside one paper, asked with that paper in scope. 'synthesis' = a corpus-wide question whose complete answer spans at least two papers. 'negative' = a question the corpus cannot answer, where the only correct behaviour is to say so.",
   "expected_papers": "synthesis only: papers a complete answer should draw on."
  },
  "corpus": "17 papers: 11 supplied by the user plus 6 fetched from arXiv (scripts/fetch_arxiv.py; ids pinned in papers/arxiv_manifest.json). The arXiv set spans cs.CL, q-bio.PE, stat.AP and econ.EM so the discipline-agnostic classifier is exercised on real papers rather than assumed to work.",
  "synthesis_rules": [
   "A complete answer needs at least two papers, or it is needle retrieval wearing a synthesis costume.",
   "The answer is a closed, enumerable set - languages, models, datasets, scores - not an invitation to discuss.",
   "It is answerable without naming a paper.",
   "Fact groups must be discriminating: a fluent non-answer must score zero. A group like ['annotat'] matches almost anything and measures nothing.",
   "Scored on two axes that fail apart - facts stated, and which papers were actually cited. An answer can name four datasets while citing one paper."
  ],
  "negative_controls": "Everything else measures false negatives - denying content that is present. These measure the opposite and more dangerous failure for a research tool: inventing an answer for content that is absent. Abstention rate here is in tension with recall on the synthesis questions, which is the point: a system that abstains on everything scores 100% here and 0% there."
 },
