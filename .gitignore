# ── Local data ─────────────────────────────────────────────────────────────
# Papers are the user's own PDFs; published articles are copyrighted and are
# not redistributed with this repo. Drop your own into papers/.
papers/*
!papers/.gitkeep
# The manifest is not data, it is the recipe: pinned arXiv ids so anyone can
# rebuild the exact corpus the golden question set was written against.
!papers/arxiv_manifest.json

# Weaviate's live data lives in the named Docker volume, not in the repo.
weaviate_data/

# Eval output (regenerate with: python scripts/eval_rag.py --all)
eval_results.json
eval_quick.json
eval_deep.json
eval_synthesis.json

# ── Secrets / local config ─────────────────────────────────────────────────
.env
.env.local

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Notebooks ──────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Models / caches ────────────────────────────────────────────────────────
.cache/
*.onnx

# ── Editors & OS ───────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Ad-hoc uploads, which are throwaway by design.
scratch/
